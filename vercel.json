{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/miternerita-front/browser"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*-[A-Z0-9]{8}\\.(js|css))",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/assets/fonts/(.*)",
      "headers": { "cache-control": "public, max-age=2592000" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "(.*)", "dest": "/index.html" }
  ]
}
